# SmartSweep backend — environment template.
#
#   cp .env.example .env
#
# Never commit .env (it is in .gitignore). This file is the documented list of
# every variable the app reads; the authoritative definitions, types, and
# defaults live in app/core/config.py.
#
# Every value below is commented out except the ones you must set. Anything left
# commented falls back to the default in config.py, so a .env that is just this
# file with DATABASE_URL uncommented is a working local setup.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# dev | test | prod. `prod` disables /docs and refuses to start on a placeholder
# JWT secret.
ENV=dev

# DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database  (required)
# ---------------------------------------------------------------------------
# Host-side development, with `docker compose up -d db`:
DATABASE_URL=postgresql+psycopg://smartsweep:smartsweep@localhost:5432/smartsweep
#
# From INSIDE the compose network the host is `db`, not localhost — compose sets
# this for the api service already, so you do not need to change it here:
#   DATABASE_URL=postgresql+psycopg://smartsweep:smartsweep@db:5432/smartsweep

# Log every SQL statement. Very noisy; turn on only while debugging a query.
# DB_ECHO=false

# ---------------------------------------------------------------------------
# Auth (JWT)  (required)
# ---------------------------------------------------------------------------
# Fine for local work. For anything deployed, generate a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
# JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated. Must include the Vite dev server or the browser blocks every
# request from the frontend. NOT a JSON array — plain comma-separated text.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# File storage (local disk; no S3/CDN in this project)
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
# 5 MB. Mirror any change into the 413 response in openapi.yaml.
# UPLOAD_MAX_BYTES=5242880
# UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# ---------------------------------------------------------------------------
# Duplicate detection (US-05, US-06)
# ---------------------------------------------------------------------------
# These MUST stay identical to Frontend/src/utils/duplicateDetection.js, or the
# advisory shown before submit will not match what the server decides.
# DUPLICATE_RADIUS_METERS=200
# DUPLICATE_TEXT_SIMILARITY_THRESHOLD=0.6
# DUPLICATE_SCORE_THRESHOLD=0.35

# ---------------------------------------------------------------------------
# Pagination
# ---------------------------------------------------------------------------
# DEFAULT_PAGE_SIZE=20
# MAX_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# External integrations (Sprint 2 — leave unset for Sprint 1)
# ---------------------------------------------------------------------------
# Claude API for hazard classification (task S2-A19). Get a key from
# console.anthropic.com. DO NOT COMMIT IT. When unset, the classify endpoint
# falls back to the citizen's manually-selected hazard instead of failing.
# ANTHROPIC_API_KEY=

# Nominatim reverse geocoding (task S2 integration). No key needed, but their
# usage policy requires an identifying User-Agent and at most 1 request/second.
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=SmartSweep/0.1 (team-028 academic project)
